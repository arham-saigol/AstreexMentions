# -----------------------------------------------------------------------------
# Web app (apps/web) and admin app (apps/admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# Required by apps/admin on the server. Access is denied when this is absent.
ADMIN_CLERK_USER_ID=

# -----------------------------------------------------------------------------
# Convex deployment environment
# Set these with `pnpm --filter @astreex/backend convex env set ...`.
# -----------------------------------------------------------------------------
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_TIMEOUT_MS=15000
# Must exceed the maximum Clerk/Convex token lifetime for stale-token rejection.
DELETION_IDENTITY_FENCE_MS=86400000
APP_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
ADMIN_CLERK_USER_ID=

# Creem. Use mode=test outside production.
CREEM_API_KEY=
CREEM_MODE=test
CREEM_TIMEOUT_MS=15000
CREEM_WEBHOOK_SECRET=
CREEM_CHECKOUT_SUCCESS_URL=http://localhost:3000/onboarding?checkout=returned
# JSON object keyed by Creem product ID. Keep limits equal to Astreex plan constants.
CREEM_PRODUCT_ALLOWLIST_JSON={"prod_starter":{"planId":"starter","mentionLimit":2000,"keywordLimit":3},"prod_growth":{"planId":"growth","mentionLimit":20000,"keywordLimit":6},"prod_scale":{"planId":"scale","mentionLimit":50000,"keywordLimit":10}}

# Email
RESEND_API_KEY=
RESEND_TIMEOUT_MS=15000
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL=Astreex <notifications@example.com>
RESEND_REPLY_TO_EMAIL=support@example.com

# Providers
FETCHLAYER_API_KEY=
XQUIK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_MS=30000

# Optional conservative provider budgets. Defaults are documented in README.md.
XQUIK_REQUESTS_PER_SECOND=100
FETCHLAYER_REQUESTS_PER_MINUTE=30
HN_REQUESTS_PER_HOUR=9000

# -----------------------------------------------------------------------------
# Credential-backed smoke tests (never required for an offline production build)
# -----------------------------------------------------------------------------
CLERK_TEST_USER_EMAIL=
CLERK_TEST_USER_PASSWORD=
