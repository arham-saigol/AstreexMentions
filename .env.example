# -----------------------------------------------------------------------------
# Web app (apps/web) and admin app (apps/admin)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ADMIN_URL=http://localhost:3001
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_SIGN_IN_URL=/sign-in
CLERK_SIGN_UP_URL=/sign-up

# Required by apps/admin on the server. Access is denied when this is absent.
ADMIN_CLERK_USER_ID=

# -----------------------------------------------------------------------------
# Convex deployment environment
# Set these with `pnpm --filter @astreex/backend convex env set ...`.
# -----------------------------------------------------------------------------
CLERK_JWT_ISSUER_DOMAIN=
CLERK_SECRET_KEY=
CLERK_TIMEOUT_MS=15000
# Must exceed the maximum Clerk/Convex token lifetime for stale-token rejection.
DELETION_IDENTITY_FENCE_MS=86400000
APP_URL=https://astreex.com
ADMIN_URL=https://astreex.arham.im
ADMIN_CLERK_USER_ID=

# Creem. Use mode=test outside production.
CREEM_API_KEY=
CREEM_MODE=test
CREEM_TIMEOUT_MS=15000
CREEM_WEBHOOK_SECRET=
CREEM_CHECKOUT_SUCCESS_URL=http://localhost:3000/onboarding?checkout=returned
# Use the three product IDs from the matching Creem test or production environment.
CREEM_PRODUCT_ID_STARTER=
CREEM_PRODUCT_ID_GROWTH=
CREEM_PRODUCT_ID_SCALE=

# Email
RESEND_API_KEY=
RESEND_TIMEOUT_MS=15000
RESEND_WEBHOOK_SECRET=
RESEND_FROM_EMAIL="Astreex <noreply@astreex.com>"
RESEND_REPLY_TO_EMAIL=hello@astreex.com

# Providers
FETCHLAYER_API_KEY=
XQUIK_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_TIMEOUT_MS=120000

# Optional conservative provider budgets. Defaults are documented in README.md.
XQUIK_REQUESTS_PER_SECOND=100
FETCHLAYER_REQUESTS_PER_MINUTE=30
HN_REQUESTS_PER_HOUR=9000
